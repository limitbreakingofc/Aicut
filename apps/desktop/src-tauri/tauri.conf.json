{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aicut",
  "version": "0.12.2",
  "identifier": "dev.limitbreaking.aicut",
  "build": {
    "beforeDevCommand": "pnpm --filter @aicut/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @aicut/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Aicut — Modular AI Studio",
        "width": 1340,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "yt-dlp",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good"
        ],
        "recommends": [
          "ffmpeg-free"
        ]
      }
    }
  }
}
