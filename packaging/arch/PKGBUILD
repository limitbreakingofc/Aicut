# Maintainer: limitbreakingofc <https://github.com/limitbreakingofc/Aicut>
pkgname=aicut
pkgver=0.10.1
pkgrel=1
pkgdesc="Aicut — Modular AI-First Media Studio for Linux (Arch/CachyOS & NVIDIA CUDA/NVENC)"
arch=('x86_64')
url="https://github.com/limitbreakingofc/Aicut"
license=('MIT')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'gstreamer'
  'gst-plugins-base'
  'gst-plugins-good'
  'gst-plugins-bad'
  'gst-libav'
  'ffmpeg'
  'yt-dlp'
)
optdepends=(
  'nvidia-utils: NVIDIA NVENC hardware encoding & Vulkan GPU acceleration'
  'cuda: Native CUDA runtime (/opt/cuda) for llama.cpp and whisper.cpp GPU acceleration'
  'vulkan-icd-loader: Vulkan GPU acceleration for local vision AI (Qwen2.5-VL)'
  'chromium: Headless CDP renderer for Motion Studio HyperFrames animations'
  'llama.cpp-cuda: Native Arch/CachyOS CUDA llama-server binary'
  'whisper.cpp-cuda: Native Arch/CachyOS CUDA whisper-cli binary'
)
makedepends=(
  'rust'
  'cargo'
  'nodejs'
  'pnpm'
  'pkgconf'
  'librsvg'
)
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/Aicut-${pkgver}"
  export CARGO_TARGET_DIR="${srcdir}/target"
  pnpm install --frozen-lockfile || pnpm install
  pnpm build:web
  cargo build --release -p aicut-cli
  cargo build --release --manifest-path apps/desktop/src-tauri/Cargo.toml
}

package() {
  cd "${srcdir}/Aicut-${pkgver}"
  install -Dm755 "${srcdir}/target/release/aicut-desktop" "${pkgdir}/usr/bin/aicut-desktop"
  install -Dm755 "${srcdir}/target/release/aicut" "${pkgdir}/usr/bin/aicut"
  install -Dm644 "apps/desktop/src-tauri/icons/128x128.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/aicut.png"
  install -Dm644 "apps/desktop/src-tauri/icons/icon.png" "${pkgdir}/usr/share/pixmaps/aicut.png"

  install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/aicut.desktop" <<'EOF'
[Desktop Entry]
Name=Aicut
Comment=Modular AI-First Media Studio for Linux (NVIDIA CUDA/NVENC)
Exec=/usr/bin/aicut-desktop
Icon=aicut
Terminal=false
Type=Application
Categories=AudioVideo;Video;AudioVideoEditing;
StartupWMClass=aicut-desktop
EOF
}
